+def _force_closure_constraint_from_tensors(
+    *,
+    geom: torch.Tensor,
+    dist: torch.Tensor,
+    frame: torch.Tensor,
+    worldid: torch.Tensor,
+    efc_address: torch.Tensor,
+    efc_force: torch.Tensor,
+    geom_finger_map: torch.Tensor,
+    geom_hand_group_map: torch.Tensor,
+    geom_object_group_map: torch.Tensor,
+    contact_ref: torch.Tensor,
+    pyramidal_cone: bool,
+    reward_scale: float,
+    penetration_reward_scale: float,
+    min_normal_force_n: float,
+    min_opposition_cosine: float,
+    max_penetration_m: float,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Evaluate a two-sided frictional force-closure bonus.
+
+    MuJoCo's contact normal points from ``geom1`` to ``geom2``.  Normals are
+    first reoriented from hand to object, then normal constraint forces are
+    accumulated per canonical finger.  A required grasp is satisfied when the
+    thumb and at least one requested non-thumb finger both carry the configured
+    minimum normal force and their contact normals oppose one another.
+
+    This is a physically grounded two-sided force-closure proxy rather than a
+    full six-dimensional grasp-wrench-space proof.  It is appropriate for the
+    thumb-opposition contact patterns produced by the action-generation stage,
+    while remaining fixed-shape and vectorized for batched MJWarp sampling.
+    """
+    num_worlds = efc_force.shape[0]
+    # ``contact_ref`` defines only the fixed hand/channel layout.  Its values
+    # must not decide which fingers are allowed to make contact: EgoEngine's
+    # action optimizer reads physical contact from simulation and does not
+    # rewrite the human prior toward an upstream-selected grasp pattern.
+    num_fingers = int(contact_ref.numel())
+    zeros = torch.zeros(num_worlds, dtype=efc_force.dtype, device=efc_force.device)
+    if num_fingers == 0 or num_fingers % 5 != 0:
+        return zeros, zeros, zeros
+
+    geom = geom.to(torch.long)
+    worldid = worldid.to(torch.long)
+    efc_address = efc_address.to(torch.long)
+    num_geoms = int(geom_finger_map.numel())
+    safe_geom = geom.clamp(0, max(num_geoms - 1, 0))
+    first_finger = geom_finger_map[safe_geom[:, 0]]
+    second_finger = geom_finger_map[safe_geom[:, 1]]
+    first_hand_group = geom_hand_group_map[safe_geom[:, 0]]
+    second_hand_group = geom_hand_group_map[safe_geom[:, 1]]
+    first_object_group = geom_object_group_map[safe_geom[:, 0]]
+    second_object_group = geom_object_group_map[safe_geom[:, 1]]
+
+    finger_first = (
+        (first_finger >= 0)
+        & (second_object_group >= 0)
+        & (torch.div(first_finger, 5, rounding_mode="floor") == second_object_group)
+    )
+    finger_second = (
+        (second_finger >= 0)
+        & (first_object_group >= 0)
+        & (torch.div(second_finger, 5, rounding_mode="floor") == first_object_group)
+    )
+    finger_pair = finger_first | finger_second
+    finger_index = torch.where(finger_first, first_finger, second_finger)
+    finger_pair = finger_pair & (finger_index >= 0) & (finger_index < num_fingers)
+
+    hand_first = (
+        (first_hand_group >= 0)
+        & (second_object_group >= 0)
+        & (first_hand_group == second_object_group)
+    )
+    hand_second = (
+        (second_hand_group >= 0)
+        & (first_object_group >= 0)
+        & (second_hand_group == first_object_group)
+    )
+    hand_object_pair = hand_first | hand_second
+
+    valid_world = (worldid >= 0) & (worldid < num_worlds)
+    safe_world = worldid.clamp(0, max(num_worlds - 1, 0))
+    address_valid = (efc_address >= 0) & (efc_address < efc_force.shape[1])
+    safe_address = efc_address.clamp(0, max(efc_force.shape[1] - 1, 0))
+    constraint_components = efc_force[
+        safe_world[:, None], safe_address
+    ]
+    constraint_components = torch.where(
+        address_valid, torch.relu(constraint_components),
+        torch.zeros_like(constraint_components),
+    )
+    if pyramidal_cone:
+        # MuJoCo's pyramidal friction cone encodes the normal force as the
+        # sum of its non-negative pyramid constraint components.
+        normal_force = constraint_components.sum(dim=1)
+    else:
+        # The first elliptic-cone constraint coordinate is normal force.
+        normal_force = constraint_components[:, 0]
+
+    touching = finger_pair & valid_world & (dist <= 0.0) & (normal_force > 0.0)
+    oriented_normal = torch.where(
+        finger_first[:, None], frame[:, 0, :], -frame[:, 0, :]
+    )
+    contact_weight = torch.where(touching, normal_force, torch.zeros_like(normal_force))
+    safe_finger = finger_index.clamp(0, num_fingers - 1)
+    flat_index = safe_world * num_fingers + safe_finger
+    flat_force = torch.zeros(
+        num_worlds * num_fingers,
+        dtype=efc_force.dtype,
+        device=efc_force.device,
+    ).scatter_add(0, flat_index, contact_weight)
+    flat_normal = torch.zeros(
+        (num_worlds * num_fingers, 3),
+        dtype=efc_force.dtype,
+        device=efc_force.device,
+    ).scatter_add(
+        0,
+        flat_index[:, None].expand(-1, 3),
+        oriented_normal * contact_weight[:, None],
+    )
+    finger_force = flat_force.reshape(num_worlds, num_fingers)
+    finger_normal = flat_normal.reshape(num_worlds, num_fingers, 3)
+    finger_normal = finger_normal / torch.linalg.vector_norm(
+        finger_normal, dim=-1, keepdim=True
+    ).clamp_min(1e-8)
+
+    groups = num_fingers // 5
+    grouped_force = finger_force.reshape(num_worlds, groups, 5)
+    grouped_normal = finger_normal.reshape(num_worlds, groups, 5, 3)
+    force_score = torch.clamp(
+        grouped_force / max(float(min_normal_force_n), 1e-8), 0.0, 1.0
+    )
+    normal_dot = (
+        grouped_normal[:, :, 0, None, :]
+        * grouped_normal[:, :, 1:, :]
+    ).sum(dim=-1)
+    opposition_score = torch.clamp(
+        -normal_dot / max(float(min_opposition_cosine), 1e-8), 0.0, 1.0
+    )
+    other_score = torch.minimum(force_score[:, :, 1:], opposition_score)
+    other_score = other_score.max(dim=2).values
+    closure_score_by_group = torch.minimum(force_score[:, :, 0], other_score)
+    closure_score = closure_score_by_group.mean(dim=1)
+    # This is an optional positive stability bonus, never a feasibility gate.
+    # Lack of force closure therefore does not penalize valid supported pushes.
+    closure_reward = float(reward_scale) * closure_score
+
+    # Unlike force closure, penetration covers every collision geom on either
+    # hand (including the palm), not only the canonical finger channels.
+    penetration = torch.where(
+        hand_object_pair & valid_world,
+        torch.relu(-dist),
+        torch.zeros_like(dist),
+    )
+    world_penetration = torch.zeros(
+        num_worlds, dtype=efc_force.dtype, device=efc_force.device
+    ).scatter_reduce(
+        0, safe_world, penetration, reduce="amax", include_self=True
+    )
+    penetration_violation = torch.relu(
+        world_penetration - float(max_penetration_m)
+    ) / max(float(max_penetration_m), 1e-8)
+    penetration_reward = (
+        -float(penetration_reward_scale)
+        * penetration_violation
+    )
+    return closure_reward + penetration_reward, closure_score, world_penetration
+
