+def _paper_pose_rewards(
+    config: Config,
+    qpos_diff: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """EgoEngine Appendix C.3/C.5 pose terms in separated form.
+
+    The object score is ``C - sqrt(lambda_p*ep^2 + lambda_R*eR^2)``.
+    ``C`` is the diagonal of the configured position/rotation feasibility
+    rectangle, so the score is non-negative everywhere inside that boundary.
+    Human mimic is a distinct squared soft prior and therefore cannot dilute
+    object tracking by being placed inside the same L2 norm.
+    """
+    if config.embodiment_type == "bimanual":
+        robot_nu = int(config.nu)
+        if config.nq_obj == 12:
+            right_obj = qpos_diff[:, -12:-6]
+            left_obj = qpos_diff[:, -6:]
+        else:
+            right_obj = qpos_diff[:, -12:-6]
+            left_obj = qpos_diff[:, -6:]
+        object_parts = (right_obj, left_obj)
+        half = robot_nu // 2
+        human_parts = (
+            qpos_diff[:, :half],
+            qpos_diff[:, half:robot_nu],
+        )
+    else:
+        robot_nu = int(config.nu)
+        object_parts = (qpos_diff[:, -6:],)
+        human_parts = (qpos_diff[:, :robot_nu],)
+
+    object_errors = []
+    for part in object_parts:
+        pos_sq = torch.sum(part[:, :3] ** 2, dim=1)
+        rot_sq = torch.sum(part[:, 3:6] ** 2, dim=1)
+        object_errors.append(torch.sqrt(
+            float(config.pos_rew_scale) * pos_sq
+            + float(config.rot_rew_scale) * rot_sq
+            + 1e-12
+        ))
+    object_tracking_error = torch.stack(object_errors, dim=1).mean(dim=1)
+    feasibility_constant = (
+        float(config.pos_rew_scale) * float(config.object_pos_threshold) ** 2
+        + float(config.rot_rew_scale) * float(config.object_rot_threshold) ** 2
+    ) ** 0.5
+    object_tracking_rew = feasibility_constant - object_tracking_error
+
+    human_costs = []
+    for part in human_parts:
+        pos_sq = torch.sum(part[:, :3] ** 2, dim=1)
+        rot_sq = torch.sum(part[:, 3:6] ** 2, dim=1)
+        joint_sq = torch.sum(part[:, 6:] ** 2, dim=1)
+        human_costs.append(
+            float(config.base_pos_rew_scale) * pos_sq
+            + float(config.base_rot_rew_scale) * rot_sq
+            + float(config.joint_rew_scale) * joint_sq
+        )
+    human_mimic_rew = -torch.stack(human_costs, dim=1).mean(dim=1)
+    return object_tracking_rew, human_mimic_rew, object_tracking_error
+
+
+def _contact_tracking_reward(
+    contact_pos: torch.Tensor, contact_pos_ref: torch.Tensor,
+    contact_ref: torch.Tensor, scale: float, opposition_scale: float = 0.0,
+) -> torch.Tensor:
+    """Track active fingertips and reward thumb-to-finger opposition."""
+    contact_dist = torch.norm(contact_pos - contact_pos_ref, p=2, dim=-1)
+    active = contact_ref.unsqueeze(0).to(contact_dist.dtype)
+    contact_dist_masked = contact_dist * active
+    # Normalize by the number of observed contacts so adding fingers cannot
+    # implicitly multiply the configured auxiliary weight.
+    active_count = active.sum(dim=1).clamp_min(1.0)
+    reward = -scale * contact_dist_masked.sum(dim=1) / active_count
+    if opposition_scale <= 0.0 or contact_ref.numel() % 5 != 0:
+        return reward
+    groups = contact_ref.numel() // 5
+    grouped_dist = contact_dist.reshape(contact_dist.shape[0], groups, 5)
+    grouped_active = (contact_ref >= 0.5).reshape(groups, 5)
+    opposed = grouped_active[:, 0] & grouped_active[:, 1:].any(dim=1)
+    other_dist = torch.where(
+        grouped_active[None, :, 1:], grouped_dist[:, :, 1:],
+        torch.full_like(grouped_dist[:, :, 1:], torch.inf),
+    ).min(dim=2).values
+    opposed_dist = grouped_dist[:, :, 0] + other_dist
+    opposed_dist = torch.where(opposed[None], opposed_dist, torch.zeros_like(opposed_dist))
+    opposed_count = opposed.sum().clamp_min(1).to(opposed_dist.dtype)
+    return reward - opposition_scale * opposed_dist.sum(dim=1) / opposed_count
+
