+    first_finger = geom_finger_map[safe_geom[:, 0]]
+    second_finger = geom_finger_map[safe_geom[:, 1]]
+    first_object_group = geom_object_group_map[safe_geom[:, 0]]
+    second_object_group = geom_object_group_map[safe_geom[:, 1]]
+    finger_first = (
+        (first_finger >= 0)
+        & (second_object_group >= 0)
+        & (torch.div(first_finger, 5, rounding_mode="floor") == second_object_group)
+    )
+    finger_second = (
+        (second_finger >= 0)
+        & (first_object_group >= 0)
+        & (torch.div(second_finger, 5, rounding_mode="floor") == first_object_group)
+    )
+    finger_pair = finger_first | finger_second
+    finger_index = torch.where(finger_first, first_finger, second_finger)
+    finger_pair = finger_pair & (finger_index >= 0) & (finger_index < num_fingers)
+
+    valid_world = (worldid >= 0) & (worldid < num_worlds)
+    safe_world = worldid.clamp(0, max(num_worlds - 1, 0))
+    address_valid = (efc_address >= 0) & (efc_address < efc_force.shape[1])
+    safe_address = efc_address.clamp(0, max(efc_force.shape[1] - 1, 0))
+    constraint_components = efc_force[safe_world[:, None], safe_address]
+    constraint_components = torch.where(
+        address_valid,
