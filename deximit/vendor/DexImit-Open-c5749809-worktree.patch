+def _snapshot_robot_state(robot):
+    """Capture all articulation state that affects the next PhysX step."""
+    joints = robot.get_active_joints()
+    return {
+        "qpos": np.asarray(robot.get_qpos()).copy(),
+        "qvel": np.asarray(robot.get_qvel()).copy(),
+        "drive_targets": tuple(
+            np.asarray(joint.get_drive_target()).copy() for joint in joints
+        ),
+        "joint_count": len(joints),
+    }
+
+
+def _restore_robot_state(robot, state):
+    """Restore articulation state without replacing its drive targets."""
+    joints = robot.get_active_joints()
+    if len(joints) != state["joint_count"]:
+        raise RuntimeError("robot active-joint count changed while testing grasps")
+
+    robot.set_qpos(state["qpos"])
+    robot.set_qvel(state["qvel"])
+    for joint, target in zip(joints, state["drive_targets"]):
+        joint.set_drive_target(target)
+
+
+def _hand_joint_position_limits(robot, hand_dof):
+    """Return active hand-joint limits in the articulation's qpos order."""
+    joints = robot.get_active_joints()
+    if len(joints) < hand_dof:
+        raise RuntimeError("robot has fewer active joints than the grasp target")
+    limits = np.asarray([
+        np.asarray(joint.get_limits(), dtype=np.float64).reshape(-1, 2)[0]
+        for joint in joints[-hand_dof:]
+    ])
+    if limits.shape != (hand_dof, 2) or not np.isfinite(limits).all():
+        raise RuntimeError("robot hand joint limits are invalid")
+    return limits[:, 0], limits[:, 1]
+
