+def _bounded_squeeze_joints(solution, joint_position_limits, squeeze_scale):
+    """Extrapolate grasp closure without commanding joints past the URDF limits."""
+    pregrasp = solution[..., 0, 7:]
+    grasp = solution[..., 1, 7:]
+    unbounded = grasp + (grasp - pregrasp) * squeeze_scale
+    lower = joint_position_limits[0]
+    upper = joint_position_limits[1]
+    bounded = torch.maximum(torch.minimum(unbounded, upper), lower)
+    return bounded, torch.ne(bounded, unbounded)
